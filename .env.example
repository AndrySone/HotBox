# Database
DB_USER=admin
DB_PASSWORD=admin
DB_NAME=print_monitoring
DB_HOST=postgres
DB_PORT=5432

# Redis
REDIS_URL=redis://redis:6379

# API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# ML Model
MODEL_PATH=/app/models/defect_detector_mobilenetv2.h5
CONFIDENCE_THRESHOLD=0.70

# Logging
LOG_LEVEL=INFO
LOG_FILE=/var/log/app.log

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=alerts@printmonitor.com
SMTP_TO=admin@printmonitor.com

# Slack Integration
SLACK_WEBHOOK=https://hooks.slack.com/services/YOUR/WEBHOOK

# Telegram Integration
TELEGRAM_TOKEN=YOUR_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_CHAT_ID

# Environment
ENVIRONMENT=development
DEBUG=False

# Security
SECRET_KEY=your_secret_key_here
ALLOWED_ORIGINS=http://localhost:3000,http://localhost

DEVICE_TOKENS=creality_k1se:devtok_k1se_xxxxxxxxxxxxxxxxxxxxx,wanhao_i3:devtok_wanhao_xxxxxxxxxxxxxxxxxxxxx,creality_ender3:devtok_ender3_xxxxxxxxxxxxxxxxxxxxx